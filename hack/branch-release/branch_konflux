"""
branch_konflux — Orchestrator for branching a new Foreman release in Konflux.

Usage:
    uv run hack/branch-release/branch_konflux --version=3.19 --dry-run

Configuration:
    Copy hack/branch-release/settings.example to hack/branch-release/settings.local
    and fill in your values. Environment variables set in your shell take
    precedence over settings.local.

Required (env var or settings.local):
    GITHUB_USER   Your GitHub username — must have forks of the OCI image repos
    GITLAB_USER   Your gitlab.com username — must have a fork of tenants-config

Optional (env var or settings.local):
    WORKTREE_DIR         Base directory for temporary worktrees (default: /tmp)
    GITHUB_FORK_URL_BASE GitHub fork URL prefix (default: https://github.com/$GITHUB_USER)
    GITLAB_FORK_URL_BASE GitLab fork URL prefix (default: https://gitlab.com/$GITLAB_USER)
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

# Allow importing lib/ from the same directory as this script.
_SCRIPT_DIR = Path(__file__).parent
sys.path.insert(0, str(_SCRIPT_DIR))


def _load_user_settings() -> None:
    """Load settings.local into os.environ if the file exists.

    Environment variables already set in the shell take precedence.
    The file uses the same shell key=value format as release settings files.
    """
    settings_path = _SCRIPT_DIR / "settings.local"
    if not settings_path.exists():
        return
    raw = settings_path.read_text()
    for token in shlex.split(raw, comments=True):
        if "=" in token:
            key, _, value = token.partition("=")
            key = key.strip()
            if key and key not in os.environ:
                os.environ[key] = value.strip()


_load_user_settings()

from lib.config import ReleaseConfig, load_config  # noqa: E402
from lib.containerfile import patch_arg  # noqa: E402
from lib.git import (  # noqa: E402
    branch_exists_remote,
    clone_repo,
